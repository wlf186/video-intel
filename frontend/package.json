{
  "name": "sandevistan-video",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/swagger-assets.mjs --check && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:swagger": "node scripts/swagger-assets.mjs --check",
    "sync:swagger": "node scripts/swagger-assets.mjs",
    "test:security": "node --test scripts/vite-security.test.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "swagger-ui-dist": "5.32.15"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scarfSettings": {
    "enabled": false
  }
}
